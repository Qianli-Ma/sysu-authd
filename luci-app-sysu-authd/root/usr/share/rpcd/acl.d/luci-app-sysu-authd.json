{
	"luci-app-sysu-authd": {
		"description": "Manage SYSU Auth",
		"read": {
			"ubus": {
				"sysu-authd": [ "status", "password_status" ]
			},
			"uci": [ "sysu-authd" ]
		},
		"write": {
			"ubus": {
				"sysu-authd": [ "set_password", "start", "stop", "reconnect" ]
			},
			"uci": [ "sysu-authd" ]
		}
	}
}
