config sysu-authd 'main'
	option enabled '0'
	option interface 'wan'
	option device ''
	option username ''
	option password_file '/etc/sysu-authd/password'
	option profile 'sysu_ruijie'
	option auth_backend 'ruijie_compat'
	option identity_format '%u'
	option eapol_version '1'
	option dhcp_after_success '1'
	option healthcheck_enable '1'
	option logoff_on_stop '1'
	option reauth_enable '1'
	option retry_initial '3'
	option retry_max '300'
	option retry_forever '1'
	option log_level 'info'
	option auth_timeout_sec '30'
	option dhcp_timeout_sec '30'
	option online_check_interval_sec '10'
	option tick_interval_msec '250'
